# Copy to .env and fill in your machine's LAN IP (not localhost — a
# physical device or simulator can't reach your laptop's localhost).
# Find it with `ipconfig getifaddr en0` (Mac Wi-Fi) or `hostname -I` (Linux).
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8000/api
EXPO_PUBLIC_SOCKET_URL=http://192.168.1.100:8000
